# Copy to .env on a new machine. .env is gitignored.
PORT=8080
JWT_SECRET=replace-me-with-a-long-random-string

# Host machine → docker compose neo4j on :7687
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
NEO4J_DATABASE=neo4j

# Host machine → docker compose redis on :6379
REDIS_URL=redis://localhost:6379

# Passwordless email codes. Leave RESEND_API_KEY empty locally (codes are not emailed).
# AUTH_DEBUG_CODES=1 returns debugCode in GraphQL — local proofs only, never on Render.
AUTH_DEBUG_CODES=1
MAIL_FROM=
RESEND_API_KEY=

# Browser origins allowed to call the API, comma-separated. Unset = the Render
# origin plus localhost / 127.0.0.1 / ::1 for local development. Native clients
# (the iOS app) do not use CORS. Setting this replaces the default entirely.
# CORS_ALLOWED_ORIGINS=https://it-project-backend-aldq.onrender.com,http://localhost:8080

# /graph explorer. Unset is public when NEO4J_URI is local and requires a
# bearer token when Neo4j is remote (Aura). Set public to open it anyway,
# auth to require a token even locally, or off to hide it.
# GRAPH_EXPLORER=public

# Production (Render dashboard, not this file):
# JWT_SECRET=<different long random string>
# NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=<aura password>
# NEO4J_DATABASE=neo4j
# REDIS_URL=redis://...
