CREATE CONSTRAINT profile_id IF NOT EXISTS FOR (p:Profile) REQUIRE p.id IS UNIQUE;
CREATE CONSTRAINT profile_patient IF NOT EXISTS FOR (p:Profile) REQUIRE p.patientId IS UNIQUE;
CREATE CONSTRAINT age_patient IF NOT EXISTS FOR (a:Age) REQUIRE a.patientId IS UNIQUE;
CREATE CONSTRAINT height_patient IF NOT EXISTS FOR (h:Height) REQUIRE h.patientId IS UNIQUE;
CREATE CONSTRAINT weight_patient IF NOT EXISTS FOR (w:Weight) REQUIRE w.patientId IS UNIQUE;
CREATE CONSTRAINT bmi_patient IF NOT EXISTS FOR (m:BodyMassIndex) REQUIRE m.patientId IS UNIQUE;
